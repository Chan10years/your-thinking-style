# DeepSeek server-side project configuration.
# Do not put user API keys here. Users enter their own API Key in the page,
# and it is sent only for the current analysis request.

# Local is the safe default. Hosted development uses .env.hosted instead.
APP_EDITION=local

DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
