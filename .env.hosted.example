# Hosted development only. Copy to .env.hosted and never commit real secrets.
APP_EDITION=hosted

DATABASE_URL=postgres://yourthinkingstyle:yourthinkingstyle@localhost:5432/yourthinkingstyle
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 32 random characters for a real hosted environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MAIL_FROM=no-reply@localhost
AVATAR_STORAGE_DIR=.data/avatars

DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
