{
  "name": "your-thinking-style",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:hosted": "node --env-file=.env.hosted ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "infra:up": "docker compose up -d postgres mailpit",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test:edition": "tsx --test tests/edition-config.test.ts",
    "test:infra": "tsx --test tests/hosted-infrastructure.test.mts",
    "test:migrations": "tsx --test tests/database-migrations.test.ts",
    "test:auth": "tsx --test tests/auth-config.test.ts tests/auth-email.test.ts tests/auth-route.test.ts",
    "test:profile": "tsx --test tests/profile.test.ts",
    "test:api": "tsx --test tests/analyze-route.test.ts",
    "test:prompt": "tsx --test tests/build-analysis-prompt.test.ts",
    "lint": "eslint",
    "test:input": "node --test tests/input-validation.test.mts",
    "test:site": "node --test tests/site-content.test.mts",
    "test:workspace": "tsx --test tests/workspace-config.test.mts",
    "test:display": "tsx --test tests/analysis-display.test.mts",
    "test:code-editor": "node --test tests/code-editor-config.test.mts",
    "test:annotations": "tsx --test tests/code-location-resolver.test.mts tests/code-annotation-decorations.test.mts",
    "test:error-linkage": "tsx --test tests/error-linkage.test.mts",
    "test:reanalysis": "tsx --test tests/reanalysis.test.mts",
    "test:supplemental": "node --test tests/supplemental-collapse.test.mts",
    "test:request-guard": "tsx --test tests/analysis-request-guard.test.ts",
    "test:schema-diagnostics": "tsx --test tests/schema-diagnostics.test.ts",
    "test:schema": "tsx --test src/schemas/analysis-response.test.ts",
    "test:dock-layout": "tsx --test tests/diagnostic-dock-layout.test.mts",
  "test": "npm run test:site && npm run test:workspace && npm run test:edition && npm run test:infra && npm run test:migrations && npm run test:auth && npm run test:profile && npm run test:input && npm run test:display && npm run test:code-editor && npm run test:annotations && npm run test:error-linkage && npm run test:reanalysis && npm run test:supplemental && npm run test:request-guard && npm run test:dock-layout && npm run test:prompt && npm run test:schema && npm run test:schema-diagnostics && npm run test:api"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@monaco-editor/react": "^4.7.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "monaco-editor": "^0.55.1",
    "next": "16.2.9",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.2",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
